<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="color-scheme" content="light">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — {{ period }}</title>
<style>
  @page { size: A4; margin: 16mm 14mm; }
  :root { --ink: #1c2127; --muted: #4e5966; --faint: #7e8a97; --rule: #d5dbe1;
          --warn: #9a6700; --warn-bg: #fff4d6; --error: #b42318; --error-bg: #fde8e7; }
  html { color-scheme: light; background: #fff; }
  * { box-sizing: border-box; }
  body { margin: 0 auto; max-width: 780px; padding: 24px; color: var(--ink); background: #fff;
         font: 13px/1.45 "Inter", system-ui, -apple-system, "Segoe UI", sans-serif; }
  h1 { margin: 0; font-size: 22px; letter-spacing: -0.01em; }
  .period { margin: 2px 0 18px; color: var(--muted); }
  section { margin: 0 0 22px; break-inside: avoid; }
  h2 { margin: 0 0 6px; padding-bottom: 4px; border-bottom: 1px solid var(--rule);
       font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  th, td { padding: 4px 6px; text-align: left; border-bottom: 1px solid var(--rule); }
  th { font-weight: 600; font-size: 11px; color: var(--muted); }
  td.num, th.num { text-align: right; }
  tr { break-inside: avoid; }
  td.warn { color: var(--warn); background: var(--warn-bg); font-weight: 600; }
  td.error { color: var(--error); background: var(--error-bg); font-weight: 600; }
  .note { color: var(--faint); font-style: italic; margin: 4px 0; }
  .legend { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 4px; font-size: 11px;
            color: var(--muted); font-variant-numeric: tabular-nums; }
  .legend b { color: var(--ink); font-weight: 600; }
  footer { margin-top: 28px; color: var(--faint); font-size: 11px; }
  @media print { body { max-width: none; padding: 0; } }
</style>
</head>
<body>
<h1>{{ title }}</h1>
<p class="period">{{ period }}</p>
{% for s in sections %}
<section>
  <h2>{{ s.title }}</h2>
  {% if s.note %}<p class="note">{{ s.note }}</p>{% endif %}
  {% if s.kind == "trend_chart" and s.chart.lines %}
  <svg width="100%" viewBox="0 0 {{ s.chart.width }} {{ s.chart.height }}" role="img"
       aria-label="{{ s.title }}">
    <line x1="{{ s.chart.left }}" y1="{{ s.chart.bottom }}" x2="{{ s.chart.right }}"
          y2="{{ s.chart.bottom }}" stroke="#d5dbe1"/>
    <line x1="{{ s.chart.left }}" y1="{{ s.chart.top }}" x2="{{ s.chart.right }}"
          y2="{{ s.chart.top }}" stroke="#eef1f4"/>
    {# Attributes, not CSS: WeasyPrint (the PDF) ignores CSS fill and font on SVG text #}
    <g fill="#7e8a97" font-size="10" font-family="system-ui, sans-serif">
    <text x="{{ s.chart.left - 6 }}" y="{{ s.chart.top + 8 }}" text-anchor="end">{{ s.chart.hi }}</text>
    <text x="{{ s.chart.left - 6 }}" y="{{ s.chart.bottom }}" text-anchor="end">{{ s.chart.lo }}</text>
    <text x="{{ s.chart.left }}" y="{{ s.chart.height - 4 }}">{{ s.start_label }}</text>
    <text x="{{ s.chart.right }}" y="{{ s.chart.height - 4 }}" text-anchor="end">{{ s.end_label }}</text>
    </g>
    {% for l in s.chart.lines %}
    <polyline fill="none" stroke="{{ l.ink }}" stroke-width="1.4"
      {% if l.dash %}stroke-dasharray="{{ l.dash }}"{% endif %} points="{{ l.points }}"/>
    {% endfor %}
  </svg>
  <div class="legend">
    {% for l in s.chart.lines %}
    <span><b>{{ l.label }}</b> min {{ l.min }} · avg {{ l.avg }} · max {{ l.max }}</span>
    {% endfor %}
  </div>
  {% elif s.rows %}
  <table>
    <thead><tr>
      {% if s.kind == "top_n" %}<th class="num">#</th>{% endif %}
      {% for c in s.columns %}
      <th{% if c not in text_columns %} class="num"{% endif %}>{{ labels.get(c, c) }}</th>
      {% endfor %}
    </tr></thead>
    <tbody>
    {% for r in s.rows %}
      <tr>
        {% if s.kind == "top_n" %}<td class="num">{{ loop.index }}</td>{% endif %}
        {% for c in s.columns %}
        {% set style = cell_style(s.kind, r, c) %}
        <td class="{{ '' if c in text_columns else 'num' }} {{ style }}">{{ cell(r, c) }}</td>
        {% endfor %}
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
</section>
{% endfor %}
<footer>Generated by HUD {{ version }} on {{ generated }} · times in {{ tz }}.
{% if skipped %}<br>Not produced: {{ skipped }}.{% endif %}</footer>
</body>
</html>
